<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Pin restore to nuget.org only. Without this the build inherits whatever feeds the developer has
    configured globally (nightly feeds, private mirrors), which under central package management
    raises NU1507 and can silently resolve different Umbraco builds on different machines.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
